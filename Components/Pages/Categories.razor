@page "/categories"
@attribute [Authorize]
@inject BlazorInventario.Repositories.ICategoriesRepository CategoriesRepo
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@inject BlazorInventario.Services.ICategoriesExportService CategoriesExportService

<PageTitle>Categorías</PageTitle>

<h3>Categorías</h3>

@if (isAdmin)
{
    <button class="btn btn-primary mb-3" @onclick="Create" disabled="@isLoading">Nueva categoría</button>
}
<button class="btn btn-outline-secondary mb-3 ms-2" @onclick="ExportCsv" disabled="@isLoading">Exportar CSV</button>

<div class="table-responsive">
    <table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th class="col-actions">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (isLoading)
        {
            if (showPlaceholder)
            {
                @for (int i = 0; i < pageSize; i++)
                {
                    <tr>
                        <td><span class="placeholder col-8 placeholder-glow"></span></td>
                        <td><span class="placeholder col-10 placeholder-glow"></span></td>
                        <td><span class="actions-placeholder"></span></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="3">Cargando...</td></tr>
            }
        }
        else if (!categories.Any())
        {
            <tr><td colspan="3">No hay categorías.</td></tr>
        }
        else
        {
            @foreach (var c in PagedCategories)
            {
                <tr>
                    <td>@c.name</td>
                    <td>@c.description</td>
                    <td class="text-nowrap">
                        <div class="d-flex gap-1 flex-nowrap">
                            <button class="btn btn-sm btn-secondary" @onclick="() => Edit(c.id)">Editar</button>
                            @if (isAdmin)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(c.id)" disabled="@(deletingId == c.id)">
                                    @if (deletingId == c.id)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span>Eliminar</span>
                                    }
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
    </table>
</div>

<nav aria-label="Paginación" class="mt-3">
    <ul class="pagination justify-content-center">
        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="PrevPage" disabled="@(CurrentPage == 1)">Anterior</button>
        </li>
        <li class="page-item active"><span class="page-link">Página @CurrentPage de @TotalPages</span></li>
        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
            <button class="page-link" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">Siguiente</button>
        </li>
    </ul>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = default!;
    private List<BlazorInventario.Repositories.CategoryRecord> categories = new();
    private bool isAdmin;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool isLoading = true;
    private bool showPlaceholder = false;

    int TotalPages => Math.Max(1, (int)Math.Ceiling(categories.Count / (double)pageSize));
    int CurrentPage => currentPage;
    IEnumerable<BlazorInventario.Repositories.CategoryRecord> PagedCategories => categories.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateTask;
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", true);
            return;
        }

        isAdmin = authState.User?.IsInRole("Admin") ?? false;

        var fetchTask = Task.Run(async () =>
        {
            categories = (await CategoriesRepo.GetAllAsync()).ToList();
        });

        var delayTask = Task.Delay(150);
        var first = await Task.WhenAny(fetchTask, delayTask);
        if (first == delayTask) showPlaceholder = true;

        await fetchTask;
        isLoading = false;
        showPlaceholder = false;
    }

    void Create() => Navigation.NavigateTo("/categories/new");
    void Edit(int id) => Navigation.NavigateTo($"/categories/{id}");

    private int? deletingId;

    async Task Delete(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "¿Confirma eliminar esta categoría? Esta acción no se puede deshacer.");
        if (!ok) return;

        try
        {
            deletingId = id;
            await CategoriesRepo.DeleteAsync(id);
            categories = (await CategoriesRepo.GetAllAsync()).ToList();
            if (currentPage > TotalPages) currentPage = TotalPages;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            deletingId = null;
            StateHasChanged();
        }
    }

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < TotalPages) currentPage++; }

    async Task ExportCsv()
    {
        try
        {
            var bytes = await CategoriesExportService.GenerateCategoriesCsvAsync();
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64", "categories.csv", base64);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }
}
