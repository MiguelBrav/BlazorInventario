@page "/kardex"
@attribute [Authorize]
@inject BlazorInventario.Repositories.IProductsRepository ProductsRepo
@inject BlazorInventario.Repositories.IMovementsRepository MovementsRepo
@inject BlazorInventario.Services.IKardexExportService KardexExportService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Kardex de Inventario</PageTitle>

<h3>Kardex de Inventario</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row mb-3">
    <div class="col-md-4">
        <label>Producto</label>
        <select class="form-select" @onchange="HandleProductChange" disabled="@isLoading">
            <option value="">-- Seleccione producto --</option>
            @foreach (var p in products)
            {
                <option value="@p.id" selected="@((selectedProductId == p.id))">@p.name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label>Desde</label>
        <InputDate @bind-Value="from" class="form-control" disabled="@isLoading" />
    </div>
    <div class="col-md-2">
        <label>Hasta</label>
        <InputDate @bind-Value="to" class="form-control" disabled="@isLoading" />
    </div>
    <div class="col-md-2">
        <label>Tipo</label>
        <select class="form-select" @onchange="HandleTypeChange" disabled="@isLoading">
            <option value="" selected="@((type == null))">-- Todos --</option>
            <option value="in" selected="@((type == "in"))">Entrada</option>
            <option value="out" selected="@((type == "out"))">Salida</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="Filter" disabled="@isLoading">Buscar</button>
    </div>
</div>

<div class="mb-3">
    <button class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@isLoading">Limpiar</button>
    @if (selectedProductId.HasValue && kardexRecords.Any())
    {
        <button class="btn btn-success ms-2" @onclick="ExportCsv" disabled="@isLoading">Exportar CSV</button>
    }
</div>

@if (selectedProduct != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@selectedProduct.name</h5>
            <div class="row">
                <div class="col-md-3">
                    <small class="text-muted">Stock actual</small>
                    <div class="fw-bold">@selectedProduct.stock_current</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Stock mínimo</small>
                    <div class="fw-bold">@selectedProduct.stock_minimum</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Costo promedio</small>
                    <div class="fw-bold">@selectedProduct.average_cost.ToString("C")</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Valor inventario</small>
                    <div class="fw-bold">@((selectedProduct.stock_current * selectedProduct.average_cost).ToString("C"))</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Motivo</th>
                <th>Referencia</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Stock</th>
                <th>Costo unitario</th>
                <th>Costo promedio</th>
            </tr>
        </thead>
        <tbody>
            @if (isLoading)
            {
                if (showPlaceholder)
                {
                    @for (int i = 0; i < pageSize; i++)
                    {
                        <tr>
                            <td><span class="placeholder col-6 placeholder-glow"></span></td>
                            <td><span class="placeholder col-4 placeholder-glow"></span></td>
                            <td><span class="placeholder col-5 placeholder-glow"></span></td>
                            <td><span class="placeholder col-3 placeholder-glow"></span></td>
                            <td><span class="placeholder col-2 placeholder-glow"></span></td>
                            <td><span class="placeholder col-2 placeholder-glow"></span></td>
                            <td><span class="placeholder col-2 placeholder-glow"></span></td>
                            <td><span class="placeholder col-3 placeholder-glow"></span></td>
                            <td><span class="placeholder col-3 placeholder-glow"></span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9">Cargando...</td></tr>
                }
            }
            else if (!selectedProductId.HasValue)
            {
                <tr><td colspan="9">Seleccione un producto para ver su kardex.</td></tr>
            }
            else if (!kardexRecords.Any())
            {
                <tr><td colspan="9">No se encontraron movimientos para este producto en el periodo seleccionado.</td></tr>
            }
            else
            {
                @foreach (var k in PagedKardex)
                {
                    var rowClass = k.canceled ? "table-secondary text-muted" : string.Empty;
                    <tr class="@rowClass">
                        <td>@k.date.ToString("g")</td>
                        <td>
                            @if (k.type == "in")
                            {
                                <span class="badge bg-success">ENTRADA</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">SALIDA</span>
                            }
                        </td>
                        <td>@GetMovementReason(k)</td>
                        <td>@k.id</td>
                        <td>@(k.type == "in" && !k.canceled ? k.quantity.ToString() : "-")</td>
                        <td>@(k.type == "out" && !k.canceled ? k.quantity.ToString() : "-")</td>
                        <td class="fw-bold">@k.running_stock</td>
                        <td>@k.unit_cost.ToString("C")</td>
                        <td>@k.running_average_cost.ToString("C")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (selectedProductId.HasValue && kardexRecords.Any())
{
    <nav aria-label="Paginación" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PrevPage" disabled="@(CurrentPage == 1)">Anterior</button>
            </li>
            <li class="page-item active"><span class="page-link">Página @CurrentPage de @TotalPages</span></li>
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">Siguiente</button>
            </li>
        </ul>
    </nav>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = default!;
    
    [SupplyParameterFromQuery(Name = "productId")]
    private int? productIdParam { get; set; }

    private List<BlazorInventario.Repositories.ProductRecord> products = new();
    private List<BlazorInventario.Repositories.KardexRecord> kardexRecords = new();
    private BlazorInventario.Repositories.ProductRecord? selectedProduct;
    private int? selectedProductId;
    private DateTime? from;
    private DateTime? to;
    private string? type;
    private string? errorMessage;
    private int currentPage = 1;
    private int pageSize = 25;
    private bool isLoading = true;
    private bool showPlaceholder = false;

    int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    int CurrentPage => currentPage;
    int totalCount = 0;
    IEnumerable<BlazorInventario.Repositories.KardexRecord> PagedKardex => kardexRecords.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateTask;
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", true);
            return;
        }

        var fetchTask = Task.Run(async () =>
        {
            products = (await ProductsRepo.GetAllAsync()).ToList();
        });

        var delayTask = Task.Delay(150);
        var first = await Task.WhenAny(fetchTask, delayTask);
        if (first == delayTask) showPlaceholder = true;

        await fetchTask;
        isLoading = false;
        showPlaceholder = false;

        // Handle URL parameter for automatic product selection
        if (productIdParam.HasValue)
        {
            selectedProductId = productIdParam.Value;
            await Filter();
        }
    }

    async Task Filter()
    {
        if (!selectedProductId.HasValue)
        {
            errorMessage = "Seleccione un producto";
            return;
        }

        errorMessage = null;
        isLoading = true;
        currentPage = 1;

        try
        {
            selectedProduct = products.FirstOrDefault(p => p.id == selectedProductId.Value);
            kardexRecords = (await MovementsRepo.GetKardexAsync(selectedProductId.Value, from, to, type, currentPage, pageSize)).ToList();
            totalCount = await MovementsRepo.GetKardexCountAsync(selectedProductId.Value, from, to, type);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    void ClearFilters()
    {
        selectedProductId = null;
        selectedProduct = null;
        from = null;
        to = null;
        type = null;
        kardexRecords = new();
        totalCount = 0;
        currentPage = 1;
        errorMessage = null;
    }

    async Task HandleProductChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (int.TryParse(value, out int productId))
        {
            selectedProductId = productId;
            await Filter();
        }
        else
        {
            selectedProductId = null;
            ClearFilters();
        }
    }

    async Task HandleTypeChange(ChangeEventArgs e)
    {
        type = e.Value?.ToString();
        if (selectedProductId.HasValue)
        {
            await Filter();
        }
    }

    string GetMovementReason(BlazorInventario.Repositories.KardexRecord k)
    {
        if (k.canceled) return "Cancelado";
        if (!string.IsNullOrEmpty(k.notes)) return k.notes;
        if (k.type == "in") return "Compra";
        return "Venta";
    }

    async Task ExportCsv()
    {
        if (!selectedProductId.HasValue || selectedProduct == null) return;

        try
        {
            var productName = selectedProduct.name ?? "Producto";
            var bytes = await KardexExportService.GenerateKardexCsvAsync(selectedProductId.Value, productName, from, to, type);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Kardex_{productName.Replace(" ", "-")}_{DateTime.Now:yyyy-MM-dd}.csv";
            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < TotalPages) currentPage++; }
}