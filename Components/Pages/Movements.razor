@page "/movements"
@attribute [Authorize]
@inject BlazorInventario.Repositories.IMovementsRepository MovementsRepo
@inject BlazorInventario.Repositories.IProductsRepository ProductsRepo
@inject BlazorInventario.Services.IInventoryService InventoryService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@inject BlazorInventario.Services.IMovementsExportService MovementsExportService
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Movimientos</PageTitle>

<h3>Historial de movimientos</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <label>Desde</label>
        <InputDate @bind-Value="from" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Hasta</label>
        <InputDate @bind-Value="to" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Producto</label>
        <select class="form-select" @bind="productId">
            <option value="">-- Todos --</option>
            @foreach (var p in products)
            {
                <option value="@p.id">@p.name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label>Tipo</label>
        <select class="form-select" @bind="type">
            <option value="">-- Todos --</option>
            <option value="in">Entrada</option>
            <option value="out">Salida</option>
        </select>
    </div>
</div>

<button class="btn btn-primary mb-3" @onclick="Filter" disabled="@isLoading">Filtrar</button>
<button class="btn btn-success mb-3 ms-2" @onclick="New" disabled="@isLoading">Nueva operación</button>
<button class="btn btn-outline-secondary mb-3 ms-2" @onclick="ExportCsv" disabled="@isLoading">Exportar CSV</button>

<div class="table-responsive">
    <table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Producto</th>
            <th>Tipo</th>
            <th>Cantidad</th>
            <th>Costo unit.</th>
            <th>Usuario</th>
            <th>Notas</th>
            <th class="col-actions">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (isLoading)
        {
            if (showPlaceholder)
            {
                @for (int i = 0; i < pageSize; i++)
                {
                    <tr>
                        <td><span class="placeholder col-6 placeholder-glow"></span></td>
                        <td><span class="placeholder col-8 placeholder-glow"></span></td>
                        <td><span class="placeholder col-4 placeholder-glow"></span></td>
                        <td><span class="placeholder col-3 placeholder-glow"></span></td>
                        <td><span class="placeholder col-4 placeholder-glow"></span></td>
                        <td><span class="placeholder col-3 placeholder-glow"></span></td>
                        <td></td>
                        <td><span class="actions-placeholder"></span></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8">Cargando...</td></tr>
            }
        }
        else if (!movements.Any())
        {
            <tr><td colspan="8">No hay movimientos.</td></tr>
        }
        else
        {
            @foreach (var m in PagedMovements)
            {
                var rowClass = m.canceled ? "table-secondary text-muted" : string.Empty;
                <tr class="@rowClass">
                    <td>@m.date.ToString("g")</td>
                    <td>@GetProductName(m.product_id)</td>
                    <td>@(m.type == "in" ? "Entrada" : "Salida")</td>
                    <td>@m.quantity</td>
                    <td>@m.unit_cost.ToString("C")</td>
                    <td>@(string.IsNullOrEmpty(m.user_name) ? "No registrado" : m.user_name)</td>
                    <td>@m.notes</td>
                    <td class="actions-cell">
                        @if (m.canceled)
                        {
                            <span class="badge bg-secondary">Cancelado</span>
                        }

                        @if (!m.canceled && isAdmin)
                        {
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => CancelMovement(m.id)" disabled="@(cancellingId == m.id)">
                                @if (cancellingId == m.id)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span class="visually-hidden">Cancelando...</span>
                                }
                                else
                                {
                                    <span>Cancelar</span>
                                }
                            </button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
    </table>
</div>

<nav aria-label="Paginación" class="mt-3">
    <ul class="pagination justify-content-center">
        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="PrevPage" disabled="@(CurrentPage == 1)">Anterior</button>
        </li>
        <li class="page-item active"><span class="page-link">Página @CurrentPage de @TotalPages</span></li>
        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
            <button class="page-link" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">Siguiente</button>
        </li>
    </ul>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = default!;
    private DateTime? from;
    private DateTime? to;
    private int? productId;
    private string? type;

    private List<BlazorInventario.Repositories.MovementRecord> movements = new();
    private List<BlazorInventario.Repositories.ProductRecord> products = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private bool isLoading = true;
    private long? cancellingId;
    private bool isAdmin;
    // showPlaceholder becomes true only if loading takes longer than threshold to avoid flicker
    private bool showPlaceholder = false;

    int TotalPages => Math.Max(1, (int)Math.Ceiling(movements.Count / (double)pageSize));
    int CurrentPage => currentPage;
    IEnumerable<BlazorInventario.Repositories.MovementRecord> PagedMovements => movements.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateTask;
        if (authState?.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", true);
            return;
        }

        isAdmin = authState.User?.IsInRole("Admin") ?? false;

        // start fetch and delay in parallel to avoid showing placeholders on fast loads
        var fetchTask = Task.Run(async () =>
        {
            products = (await ProductsRepo.GetAllAsync()).ToList();
            movements = (await MovementsRepo.GetRecentAsync(50)).ToList();
        });

        var delayTask = Task.Delay(150);

        var first = await Task.WhenAny(fetchTask, delayTask);
        if (first == delayTask)
        {
            showPlaceholder = true;
        }

        await fetchTask; // ensure data loaded
        isLoading = false;
        showPlaceholder = false;
    }

    string? GetProductName(int id) => products.FirstOrDefault(p => p.id == id)?.name;

    async Task Filter()
    {
        movements = (await MovementsRepo.GetByFiltersAsync(from, to, productId, type)).ToList();
        currentPage = 1;
    }

    async Task ExportCsv()
    {
        var bytes = await MovementsExportService.GenerateMovementsCsvAsync(from, to, productId, type);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", "movements.csv", base64);
    }

    async Task CancelMovement(long id)
    {
        if (!isAdmin)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permiso para cancelar movimientos. Solo administradores pueden hacerlo.");
            return;
        }

        var ok = await JS.InvokeAsync<bool>("confirm", "¿Confirma cancelar este movimiento?");
        if (!ok) return;

        try
        {
            cancellingId = id;
            await InventoryService.CancelMovementAsync(id);

            // Reload movements and products to reflect recalculated costs/stock
            movements = (await MovementsRepo.GetRecentAsync(50)).ToList();
            products = (await ProductsRepo.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            cancellingId = null;
            StateHasChanged();
        }
    }

    void New() => Navigation.NavigateTo("/movements/new");
    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < TotalPages) currentPage++; }
}
